{
  "rules": {
    "categories": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'rafitacakes@gmail.com')"
    },
    "products": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'rafitacakes@gmail.com')"
    },
    "product_variants": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'rafitacakes@gmail.com')"
    },
    "custom_cake_types": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'rafitacakes@gmail.com')"
    },
    "custom_cake_templates": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.token.email === 'rafitacakes@gmail.com')"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'rafitacakes@gmail.com')",
        ".write": false
      }
    }
  }
}
